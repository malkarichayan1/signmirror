# Firebase project config — copy this file to .env and fill in real values
# from your Firebase project: console.firebase.google.com > Project settings
# > General > "Your apps" > Web app > SDK setup and configuration > Config.
#
# These are Firebase's public client-side identifiers, not secrets — access
# to your data is controlled by Firestore security rules, not by keeping
# these values hidden. Still gitignored here so each environment (local,
# staging, prod) can point at a different Firebase project without a code
# change.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
